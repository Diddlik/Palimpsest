{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palimpsest",
  "version": "0.2.0",
  "identifier": "com.palimpsest.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Palimpsest",
        "width": 540,
        "height": 680,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Diddlik/Palimpsest/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NTIwMDJBQUI0MDYyRTUKUldUbFlrQ3JLZ0JTZEZXTHREblMrNGlNUEFGcUNsYXpmQ0plenBiTmVVZzhwWEsyb2ZFeFlId3oK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Palimpsest",
    "category": "Productivity",
    "shortDescription": "Fixes wrong-keyboard-layout typing in place.",
    "longDescription": "Palimpsest detects when you've typed a word in the wrong keyboard layout, erases the gibberish, switches the OS layout, and retypes the text you meant — like Punto Switcher. Everything stays on your machine; it never records what you type.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
